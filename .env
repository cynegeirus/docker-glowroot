# Version
GLOWROOT_VERSION=0.14.2

# Ports
GLOWROOT_UI_PORT=4000
GLOWROOT_AGENT_PORT=8181

# Cassandra
CASSANDRA_CLUSTER_NAME=GlowrootCluster
CASSANDRA_DC=dc1
CASSANDRA_RACK=rack1
CASSANDRA_HEAP_NEW=512M
CASSANDRA_HEAP_MAX=4G
CASSANDRA_MEM_LIMIT=6G

# Glowroot Heap
GLOWROOT_HEAP_MIN=2G
GLOWROOT_HEAP_MAX=4G
GLOWROOT_MEM_LIMIT=6G
